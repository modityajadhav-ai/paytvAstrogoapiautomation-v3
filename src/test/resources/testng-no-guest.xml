<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="API Automation Suite (no guest)" verbose="1">

    <listeners>

        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>

    </listeners>

    <test name="API Regression - Run 1 (logged-in only)" preserve-order="true">

        <classes>

            <class name="com.automation.api.tests.ContentDetail"/>

            <class name="com.automation.api.tests.ContinueWatch"/>

            <class name="com.automation.api.tests.ContinueWatchScenarios"/>

            <class name="com.automation.api.tests.WatchAgain"/>

            <class name="com.automation.api.tests.WatchlistFavourite"/>

            <class name="com.automation.api.tests.BoxsetBingeWatchScenarios">
                <methods>
                    <include name="step01_getContinueWatchAndDeleteAllItems"/>
                    <include name="step02_addSharedMovieM1PartialBelow96Percent"/>
                    <include name="step03_getContinueWatch_m1PresentOnly"/>
                    <include name="step04_addSharedMovieM1CompletedHasCompletedPlayBackTrue"/>
                    <include name="step05_getCw_m1AbsentT1Present_getWa_m1Present"/>
                    <include name="step06_addSharedTvT1CompletedHasCompletedPlayBackTrue"/>
                    <include name="step07_getWatchAgain_m1AndT1Present"/>
                    <include name="step08_getContinueWatch_m2AndM3Present_t1Absent"/>
                    <include name="step09_addM2Completed_getCw_m2Absent_getWa_m2Present"/>
                    <include name="step10_getContinueWatch_t2Present_t3Absent"/>
                    <include name="step11_addM3Completed_getCw_m3AbsentT3Present_getWa_m3Present"/>
                    <include name="step12_addT2Completed_getCw_t2Absent_getWa_t2Present"/>
                    <include name="step13_addT3Completed_getCw_t3Absent_getWa_t3Present"/>
                    <include name="step14_getBoxsetBingeApi_boxset1_returns200"/>
                    <include name="step15_getBoxsetBingeApi_boxset2_returns200"/>
                    <include name="step16_getContinueWatchBoxsetContent_boxset1_returns200"/>
                </methods>
            </class>

            <class name="com.automation.api.tests.LearnAction">
                <methods>
                    <exclude name="learnAction_postAction_guest_returns200"/>
                </methods>
            </class>

            <class name="com.automation.api.tests.RecommendationProxy"/>

            <class name="com.automation.api.tests.VRSearchProxy">
                <methods>
                    <exclude name="globalContentSearch_guestUser_returnsResults"/>
                    <exclude name="searchSuggester_guestUser_returnsResults"/>
                    <exclude name="searchByUsecase_guestUser_returnsResults"/>
                    <exclude name="subgenrePreference_guestUser_returnsResults"/>
                </methods>
            </class>

            <class name="com.automation.api.tests.LockChannel"/>

            <class name="com.automation.api.tests.LastTunedChannel"/>

            <class name="com.automation.api.tests.SearchHistory"/>

            <class name="com.automation.api.tests.HomescreenMenu"/>

            <class name="com.automation.api.tests.HomescreenProxy"/>

            <class name="com.automation.api.tests.ConfigService"/>

            <class name="com.automation.api.tests.Footer"/>

        </classes>

    </test>

</suite>
