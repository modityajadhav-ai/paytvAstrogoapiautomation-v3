<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  RecommendationProxy only.
  Run: scripts/run-recommendation-proxy.bat [env]  OR
       mvn test -Pprod -Dsurefire.suiteXmlFiles=src/test/resources/testng-recommendation-proxy.xml
-->
<suite name="Recommendation Proxy Suite" verbose="1" parallel="false">
    <listeners>
        <listener class-name="com.automation.api.listeners.SuiteBootstrapListener"/>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
    </listeners>
    <test name="RecommendationProxy" preserve-order="true">
        <classes>
            <class name="com.automation.api.tests.RecommendationProxy"/>
        </classes>
    </test>
</suite>
