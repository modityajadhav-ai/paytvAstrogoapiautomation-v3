# VRGO auth secrets — LOCAL ONLY (gitignored when copied)
#
# Copy this file to the matching per-environment secrets file, then remove .example:
#
#   secrets/vrgo-auth.test.local.properties
#   secrets/vrgo-auth.dev.local.properties
#   secrets/vrgo-auth.stage.local.properties
#   secrets/vrgo-auth.stage2.local.properties
#   secrets/vrgo-auth.load.local.properties
#   secrets/vrgo-auth.prod.local.properties
#
# Legacy fallback (still supported):
#   secrets/vrgo-auth.local.properties
#
# CI alternative — set environment variables instead of this file:
#   VRGO_REFRESH_TOKEN_<ENV>   (e.g. VRGO_REFRESH_TOKEN_STAGE)
#   VRGO_AUTH_USERNAME_<ENV>
#   VRGO_AUTH_PASSWORD_<ENV>
#
# How to get vrgo.refresh.token:
#   1. Log in to the VRGO web app with a SUBSCRIBER test account (not guest).
#   2. Browser DevTools → Network → auth/token response → copy refresh_token.
#   3. Paste below. Do NOT use a guest JWT here (isGuest:true → 401 on subscriber APIs).
#
# How to get vrgo.search.proxy.guest.bearer.token:
#   1. Choose "Continue As Guest" on the web app.
#   2. DevTools → Network → any API call → Authorization header → copy after "Bearer ".
#   3. Re-paste every ~5 minutes (short TTL).

# --- Subscriber auth (required for most tests) ---

vrgo.refresh.token=PASTE_SUBSCRIBER_REFRESH_TOKEN_HERE

vrgo.auth.username=your.test.account@example.com
vrgo.auth.password=your-test-password

# Browser auto-recovery when refresh token is revoked (requires Playwright)
vrgo.auth.browser.recovery.enabled=true
vrgo.auth.browser.evict.device.on.limit=true

# Optional: show browser window during recovery (default headless)
# vrgo.auth.browser.headed=true

# Optional: recovery timeout in milliseconds
# vrgo.auth.browser.timeout.ms=120000

# --- Guest auth (required for VR Search Proxy guest tests only) ---

vrgo.search.proxy.guest.bearer.token=PASTE_GUEST_BEARER_JWT_HERE

# --- Portal HTTP basic auth (only if a popup appears BEFORE the welcome page) ---

# vrgo.web.basic.auth.username=
# vrgo.web.basic.auth.password=

# --- Optional overrides ---

# vrgo.profile.id=
# vrgo.bearer.token=
# vrgo.token.generator.entitlements=
