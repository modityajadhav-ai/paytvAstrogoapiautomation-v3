# Copy to scripts\.env and fill in values. Never commit scripts\.env.

# SMTP (Office 365, Gmail app password, SendGrid, etc.)
SMTP_SERVER=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=automation@yourcompany.com
SMTP_PASSWORD=your-app-password-or-smtp-key
SMTP_FROM=automation@yourcompany.com

# Comma-separated recipient list
REPORT_RECIPIENTS=team1@yourcompany.com,team2@yourcompany.com

# VRGO credentials for scheduled local runs (optional if set in BaseTest for dev only)
# VRGO_BEARER_TOKEN=
# VRGO_REFRESH_TOKEN=
# VRGO_X_API_KEY=
